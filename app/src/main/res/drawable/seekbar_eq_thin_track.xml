<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:left="13dp" android:right="13dp">
        <shape android:shape="rectangle">
            <size android:width="2dp" android:height="2dp" />
            <corners android:radius="1dp" />
            <solid android:color="#33485B66" />
        </shape>
    </item>
    <item android:id="@android:id/progress" android:left="13dp" android:right="13dp">
        <clip>
            <shape android:shape="rectangle">
                <size android:width="2dp" android:height="2dp" />
                <corners android:radius="1dp" />
                <solid android:color="#D8B7813F" />
            </shape>
        </clip>
    </item>
</layer-list>
